  "TI process template (.pro)": {
    "prefix": [
      "protemplate",
      "Vorlage_TI"
    ],
    "body": [
      "601,100",
      "602,\"${1:ProcessName}\"",
      "562,\"NULL\"",
      "586,",
      "585,",
      "564,",
      "565,",
      "559,1",
      "928,0",
      "593,",
      "594,",
      "595,",
      "597,",
      "598,",
      "596,",
      "800,",
      "801,",
      "566,0",
      "567,\",\"",
      "588,\".\"",
      "589,\",\"",
      "568,\"\\\"\"",
      "570,",
      "571,",
      "569,0",
      "592,0",
      "599,1000",
      "560,0",
      "561,0",
      "590,0",
      "637,0",
      "577,0",
      "578,0",
      "579,0",
      "580,0",
      "581,0",
      "582,0",
      "603,0",
      "572,4",
      "#****Begin: Generated Statements***",
      "#****End: Generated Statements****",
      "",
      "${2:# Prolog}",
      "573,4",
      "#****Begin: Generated Statements***",
      "#****End: Generated Statements****",
      "",
      "${3:# Metadata}",
      "574,4",
      "#****Begin: Generated Statements***",
      "#****End: Generated Statements****",
      "",
      "${4:# Data}",
      "575,4",
      "#****Begin: Generated Statements***",
      "#****End: Generated Statements****",
      "",
      "${5:# Epilog}",
      "576,CubeAction=1511DataAction=1503CubeLogChanges=0",
      "930,0",
      "638,1",
      "804,0",
      "1217,1"
    ],
    "description": "Native TM1 .pro file template"
  },
  "IF Block": {
    "prefix": "if",
    "body": [
      "IF($1);",
      "\t$2",
      "ELSEIF($3);",
      "\t$4",
      "ELSE;",
      "\t$5",
      "ENDIF;"
    ],
    "description": "IF / ELSEIF / ELSE / ENDIF"
  },
  "IF simple": {
    "prefix": "ifs",
    "body": [
      "IF($1);",
      "\t$2",
      "ENDIF;"
    ],
    "description": "IF / ENDIF"
  },
  "WHILE Loop": {
    "prefix": "while",
    "body": [
      "WHILE($1);",
      "\t$2",
      "END;"
    ],
    "description": "WHILE / END"
  },
